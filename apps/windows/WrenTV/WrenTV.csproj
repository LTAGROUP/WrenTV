<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WrenTV</RootNamespace>
    <AssemblyName>WrenTV</AssemblyName>
    <Product>Wren TV</Product>
    <Company>LTA Group</Company>
    <Version>1.6.6</Version>
    <ApplicationIcon>Assets\WrenTV.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Code-only WinUI: no XAML files, so no XAML compiler pass. -->
    <UseWinUI>true</UseWinUI>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <!-- An ordinary installed app (Inno Setup), carrying its own runtimes. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Generates WrenTV.pri, merging the framework's control resources. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Lets the C# compile on macOS/Linux for checking; real builds run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WrenTV.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- libmpv, fetched by the build (see .github/workflows/windows.yml). -->
    <None Include="lib\$(Platform)\*.dll" Condition="Exists('lib\$(Platform)')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
