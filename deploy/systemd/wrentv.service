[Unit]
Description=Wren TV Media Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wrentv
Group=wrentv
# Membership in "render"/"video" gives access to /dev/dri for VAAPI/QSV.
SupplementaryGroups=render video
Environment=WRENTV_DATA_DIR=/var/lib/wrentv
ExecStart=/usr/local/bin/wrentv
Restart=on-failure
RestartSec=5
StateDirectory=wrentv
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
